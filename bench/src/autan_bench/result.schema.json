{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Remenby31/autan/bench/result.schema.json",
  "title": "Autan benchmark result",
  "description": "One benchmark run: provenance, measurement conditions and per-benchmark samples with summary statistics. Produced by `autan-bench`, consumed by `autan-bench compare` and the baselines in bench/baselines/.",
  "type": "object",
  "required": [
    "schema",
    "suite",
    "created",
    "provenance",
    "conditions",
    "config",
    "benchmarks"
  ],
  "additionalProperties": false,
  "$defs": {
    "spread": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "min",
        "median",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number"
        },
        "median": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "n",
        "median",
        "q1",
        "q3",
        "iqr",
        "mean",
        "stdev",
        "cv",
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 2
        },
        "median": {
          "type": "number"
        },
        "q1": {
          "type": "number"
        },
        "q3": {
          "type": "number"
        },
        "iqr": {
          "type": "number",
          "minimum": 0
        },
        "mean": {
          "type": "number"
        },
        "stdev": {
          "type": "number",
          "minimum": 0
        },
        "cv": {
          "type": "number",
          "minimum": 0
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "cuda_gpu": {
      "type": "object",
      "required": [
        "name",
        "uuid",
        "compute_capability",
        "sm_count",
        "l2_bytes",
        "memory_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "uuid": {
          "type": "string",
          "pattern": "^GPU-[0-9a-f-]{36}$"
        },
        "compute_capability": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "sm_count": {
          "type": "integer",
          "minimum": 1
        },
        "l2_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "NVIDIA or AMD GPU, as the CUDA/HIP runtime reports it."
    },
    "metal_gpu": {
      "description": "Apple GPU, as Metal reports it. l2_bytes, when given, comes from the chip's published specification.",
      "type": "object",
      "required": [
        "name",
        "registry_id",
        "gpu_cores",
        "recommended_max_working_set_bytes",
        "memory_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "registry_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "gpu_cores": {
          "type": "integer",
          "minimum": 1
        },
        "recommended_max_working_set_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "l2_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "autan.bench-result/1"
    },
    "suite": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "description": "Run identity, named as in docs/contracts/results.md (solver.commit, backend, precision, devices), plus the host, image and GPU the numbers depend on.",
      "type": "object",
      "required": [
        "solver",
        "binary_sha256",
        "backend",
        "precision",
        "devices",
        "host",
        "image",
        "image_revision",
        "runtime_version",
        "driver_version",
        "gpu"
      ],
      "additionalProperties": false,
      "properties": {
        "solver": {
          "type": "object",
          "required": [
            "commit",
            "dirty"
          ],
          "additionalProperties": false,
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "dirty": {
              "type": "boolean"
            }
          }
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "backend": {
          "enum": [
            "cuda",
            "hip",
            "metal",
            "cpu"
          ]
        },
        "precision": {
          "enum": [
            "fp32",
            "fp32+acc64",
            "fp64"
          ]
        },
        "devices": {
          "type": "object",
          "required": [
            "kind",
            "count"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "cuda",
                "hip",
                "metal",
                "cpu"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_version": {
          "type": "integer"
        },
        "driver_version": {
          "type": "integer"
        },
        "gpu": {
          "oneOf": [
            {
              "$ref": "#/$defs/cuda_gpu"
            },
            {
              "$ref": "#/$defs/metal_gpu"
            }
          ]
        },
        "os_version": {
          "type": "string",
          "description": "Operating system version, where the runtime has no version of its own (Metal: macOS)."
        }
      }
    },
    "conditions": {
      "type": "object",
      "required": [
        "lock",
        "lock_wait_s",
        "idle_check",
        "during_run"
      ],
      "additionalProperties": false,
      "properties": {
        "lock": {
          "type": "string"
        },
        "lock_wait_s": {
          "type": "number",
          "minimum": 0
        },
        "idle_check": {
          "type": "object",
          "required": [
            "samples",
            "compute_apps_max",
            "utilization_pct_max"
          ],
          "additionalProperties": false,
          "properties": {
            "samples": {
              "type": "integer",
              "minimum": 1
            },
            "compute_apps_max": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 0,
              "description": "null where the platform does not list GPU processes (macOS)."
            },
            "utilization_pct_max": {
              "type": "number"
            }
          }
        },
        "during_run": {
          "type": "object",
          "required": [
            "samples",
            "busy_samples",
            "sm_mhz",
            "sm_max_mhz",
            "power_w",
            "temperature_c",
            "clocks_event_reasons",
            "compute_apps_max",
            "busy_threshold_pct"
          ],
          "additionalProperties": false,
          "properties": {
            "samples": {
              "type": "integer",
              "minimum": 1
            },
            "busy_samples": {
              "type": "integer",
              "minimum": 1,
              "description": "Samples above busy_threshold_pct; the clock, power and temperature spreads cover only these."
            },
            "sm_mhz": {
              "$ref": "#/$defs/spread"
            },
            "sm_max_mhz": {
              "type": [
                "number",
                "null"
              ]
            },
            "power_w": {
              "$ref": "#/$defs/spread"
            },
            "temperature_c": {
              "$ref": "#/$defs/spread"
            },
            "clocks_event_reasons": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^0x[0-9a-f]{16}$",
              "description": "OR of the clock event reasons seen; null where the platform does not report them."
            },
            "compute_apps_max": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1,
              "description": "null where the platform does not list GPU processes: contention unchecked."
            },
            "busy_threshold_pct": {
              "type": "number",
              "description": "Utilization above which a sample counts as busy: 50 % with nvidia-smi, 5 % on macOS."
            },
            "utilization_pct": {
              "$ref": "#/$defs/spread"
            }
          }
        },
        "host_load": {
          "type": "object",
          "required": [
            "cpus",
            "before_1m",
            "after_1m"
          ],
          "additionalProperties": false,
          "description": "Host runnable threads (median over 2 s, the observer excluded; what --max-load gates) and 1-minute load average before and after the run: on unified memory, other processes' CPU work takes bandwidth from the GPU. Runs before the runnable count was recorded lack it.",
          "properties": {
            "cpus": {
              "type": "integer",
              "minimum": 1
            },
            "before_runnable": {
              "type": "number",
              "minimum": 0
            },
            "after_runnable": {
              "type": "number",
              "minimum": 0
            },
            "before_1m": {
              "type": "number",
              "minimum": 0
            },
            "after_1m": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "setup_seconds": {
          "type": "object",
          "description": "Untimed setup durations the binary reports (mesh read, renumbering, ...).",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "setup_outside_lock_s": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds a gated binary (autan-bench run --ready) spent setting up before the GPU lock was taken; absent for an ungated binary."
        },
        "host_activity": {
          "type": "object",
          "required": [
            "before",
            "after"
          ],
          "additionalProperties": false,
          "description": "Host-wide activity right before the run starts and right after it returns (Linux): load, pressure (PSI), reclaim and compaction counters (/proc/vmstat), memory, with the monotonic time of each reading. Only the host's counters, no other tenant's container (#400). autan-bench writes it for every Linux run; results written before 2026-11-02 (the committed baselines among them) and macOS results lack it.",
          "properties": {
            "before": {
              "type": "object",
              "required": [
                "monotonic_s"
              ],
              "additionalProperties": false,
              "properties": {
                "monotonic_s": {
                  "type": "number",
                  "description": "time.monotonic() of the reading: the two readings' difference turns counters into rates."
                },
                "loadavg": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "procs_running": {
                  "type": "integer",
                  "minimum": 0
                },
                "procs_blocked": {
                  "type": "integer",
                  "minimum": 0
                },
                "lxcfs": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "/proc/meminfo",
                      "/proc/pressure"
                    ]
                  },
                  "description": "Files served by LXCFS (a container's view): their readings are left out."
                },
                "pressure": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cpu": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "some": {
                          "type": "object",
                          "required": [
                            "avg10",
                            "avg60",
                            "avg300",
                            "total"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "avg10": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg60": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg300": {
                              "type": "number",
                              "minimum": 0
                            },
                            "total": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        },
                        "full": {
                          "type": "object",
                          "required": [
                            "avg10",
                            "avg60",
                            "avg300",
                            "total"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "avg10": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg60": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg300": {
                              "type": "number",
                              "minimum": 0
                            },
                            "total": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        }
                      }
                    },
                    "memory": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "some": {
                          "type": "object",
                          "required": [
                            "avg10",
                            "avg60",
                            "avg300",
                            "total"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "avg10": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg60": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg300": {
                              "type": "number",
                              "minimum": 0
                            },
                            "total": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        },
                        "full": {
                          "type": "object",
                          "required": [
                            "avg10",
                            "avg60",
                            "avg300",
                            "total"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "avg10": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg60": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg300": {
                              "type": "number",
                              "minimum": 0
                            },
                            "total": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        }
                      }
                    },
                    "io": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "some": {
                          "type": "object",
                          "required": [
                            "avg10",
                            "avg60",
                            "avg300",
                            "total"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "avg10": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg60": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg300": {
                              "type": "number",
                              "minimum": 0
                            },
                            "total": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        },
                        "full": {
                          "type": "object",
                          "required": [
                            "avg10",
                            "avg60",
                            "avg300",
                            "total"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "avg10": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg60": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg300": {
                              "type": "number",
                              "minimum": 0
                            },
                            "total": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "vmstat": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^(pgscan|pgsteal|compact|pgmigrate|thp)_[a-z0-9_]+$|^pgfault$|^pgmajfault$"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "meminfo_bytes": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "MemFree": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "MemAvailable": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "Cached": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "Dirty": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "Writeback": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "AnonPages": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "after": {
              "type": "object",
              "required": [
                "monotonic_s"
              ],
              "additionalProperties": false,
              "properties": {
                "monotonic_s": {
                  "type": "number",
                  "description": "time.monotonic() of the reading: the two readings' difference turns counters into rates."
                },
                "loadavg": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "procs_running": {
                  "type": "integer",
                  "minimum": 0
                },
                "procs_blocked": {
                  "type": "integer",
                  "minimum": 0
                },
                "lxcfs": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "/proc/meminfo",
                      "/proc/pressure"
                    ]
                  },
                  "description": "Files served by LXCFS (a container's view): their readings are left out."
                },
                "pressure": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cpu": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "some": {
                          "type": "object",
                          "required": [
                            "avg10",
                            "avg60",
                            "avg300",
                            "total"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "avg10": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg60": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg300": {
                              "type": "number",
                              "minimum": 0
                            },
                            "total": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        },
                        "full": {
                          "type": "object",
                          "required": [
                            "avg10",
                            "avg60",
                            "avg300",
                            "total"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "avg10": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg60": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg300": {
                              "type": "number",
                              "minimum": 0
                            },
                            "total": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        }
                      }
                    },
                    "memory": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "some": {
                          "type": "object",
                          "required": [
                            "avg10",
                            "avg60",
                            "avg300",
                            "total"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "avg10": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg60": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg300": {
                              "type": "number",
                              "minimum": 0
                            },
                            "total": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        },
                        "full": {
                          "type": "object",
                          "required": [
                            "avg10",
                            "avg60",
                            "avg300",
                            "total"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "avg10": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg60": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg300": {
                              "type": "number",
                              "minimum": 0
                            },
                            "total": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        }
                      }
                    },
                    "io": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "some": {
                          "type": "object",
                          "required": [
                            "avg10",
                            "avg60",
                            "avg300",
                            "total"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "avg10": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg60": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg300": {
                              "type": "number",
                              "minimum": 0
                            },
                            "total": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        },
                        "full": {
                          "type": "object",
                          "required": [
                            "avg10",
                            "avg60",
                            "avg300",
                            "total"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "avg10": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg60": {
                              "type": "number",
                              "minimum": 0
                            },
                            "avg300": {
                              "type": "number",
                              "minimum": 0
                            },
                            "total": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "vmstat": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^(pgscan|pgsteal|compact|pgmigrate|thp)_[a-z0-9_]+$|^pgfault$|^pgmajfault$"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "meminfo_bytes": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "MemFree": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "MemAvailable": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "Cached": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "Dirty": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "Writeback": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "AnonPages": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "config": {
      "type": "object"
    },
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "metric",
          "unit",
          "better",
          "samples",
          "stats"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
          },
          "metric": {
            "enum": [
              "bandwidth",
              "time_per_cell_iteration"
            ]
          },
          "unit": {
            "enum": [
              "GB/s",
              "ns"
            ]
          },
          "better": {
            "enum": [
              "higher",
              "lower"
            ]
          },
          "bytes_per_rep": {
            "type": "integer",
            "minimum": 1
          },
          "cells_per_rep": {
            "type": "integer",
            "minimum": 1
          },
          "params": {
            "type": "object",
            "description": "Kernel parameters reported by the binary (strategy, layout, ...)."
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minItems": 2
          },
          "stats": {
            "$ref": "#/$defs/stats"
          }
        }
      }
    },
    "pooled_from": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "date-time"
      },
      "description": "Creation times of the runs whose samples this result pools (autan-bench baseline with several runs)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "backend": {
                "enum": [
                  "cuda",
                  "hip"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "gpu": {
                "$ref": "#/$defs/cuda_gpu"
              }
            }
          },
          "conditions": {
            "properties": {
              "idle_check": {
                "properties": {
                  "compute_apps_max": {
                    "type": "integer"
                  }
                }
              },
              "during_run": {
                "properties": {
                  "compute_apps_max": {
                    "type": "integer"
                  },
                  "clocks_event_reasons": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "backend": {
                "enum": [
                  "metal"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "gpu": {
                "$ref": "#/$defs/metal_gpu"
              },
              "precision": {
                "enum": [
                  "fp32",
                  "fp32+acc64"
                ],
                "description": "Metal has no FP64 arithmetic."
              }
            }
          }
        }
      }
    }
  ]
}
