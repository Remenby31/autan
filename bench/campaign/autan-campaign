#!/usr/bin/env python3
"""autan-campaign: CPU campaigns on a DGX Spark that never disturb a GPU measurement.

    autan-campaign start NAME [--cpus 12] [--free 24G] [--image autan-dev:local] [--dir DIR] -- COMMAND...
    autan-campaign status
    autan-campaign stop NAME

A campaign runs COMMAND in a container limited to --cpus cores at nice 19, without the GPU and
without the GPU lock. A watcher on the host freezes the whole container (docker pause, the cgroup
v2 freezer) whenever a process holds or waits for /home/admin/autan-gpu/gpu.lock without also
holding untimed.lock (autan-gpu-lock --untimed: a build, a functional test), and thaws it when
none does: on the GB10 the CPU shares the GPU's memory, so a running campaign would lower the
bandwidth a measurement sees. The watcher publishes each campaign's state next to the lock
(campaigns/NAME.state: "running" before any start or thaw, "frozen" once frozen, and a heartbeat
touched at every poll), and autan-bench measures only once every live campaign reads frozen. The container stops by itself when the watcher's
heartbeat is a minute old, so a campaign never outlives its watcher. The watcher removes the
campaign if more than 6 threads outside every campaign stay runnable for a minute, and as soon
as the host's available memory falls below --free (autan_memfloor.py). See docs/infra/bench.md.
"""

from __future__ import annotations

import argparse
import contextlib
import os
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from collections.abc import Callable

# autan_memfloor sits beside this script once installed, in bench/lock/ in the repository.
sys.path.append(str(Path(__file__).resolve().parents[1] / "lock"))
sys.dont_write_bytecode = True
import autan_memfloor as memfloor

LOCK = Path(os.environ.get("AUTAN_GPU_LOCK", "/home/admin/autan-gpu/gpu.lock"))
# Held (shared) by a holder of the GPU lock that times nothing (autan-gpu-lock --untimed: a build,
# a functional test): campaigns are not frozen for it. Any other user of the GPU lock, a legacy
# one included, is taken as timed.
UNTIMED = LOCK.parent / "untimed.lock"
STATES = LOCK.parent / "campaigns"
CGROUPS = Path("/sys/fs/cgroup")
PREFIX = "autan-campaign-"
STATE = Path.home() / "autan-campaigns"
POLL_S = 0.1
LOAD_EVERY_S = 1.0
LOAD_SAMPLES = 10
MAX_OTHER_LOAD = 6
LOAD_GRACE_S = 60.0
DOCKER_TIMEOUT_S = 30
HEARTBEAT_MAX_AGE_S = 60
# PID 1 of the container: runs the command, and stops the container when the watcher's heartbeat
# ($1, mounted read-only) is older than $2 seconds. Frozen with the rest while paused.
SUPERVISOR = r"""
heartbeat=$1 max_age=$2; shift 2
"$@" &
child=$!
while kill -0 "$child" 2>/dev/null; do
  age=$(( $(date +%s) - $(stat -c %Y "$heartbeat") ))
  if [ "$age" -gt "$max_age" ]; then
    echo "autan-campaign: watcher heartbeat ${age} s old; stopping" >&2
    exit 125
  fi
  sleep 2
done
wait "$child"
"""


def lock_in_use(lock: Path, proc_locks: str) -> bool:
    """Whether any process holds or waits for a flock on ``lock``, read from /proc/locks."""
    st = lock.stat()
    key = f"{os.major(st.st_dev):02x}:{os.minor(st.st_dev):02x}:{st.st_ino}"
    # proc(5): "N: FLOCK ADVISORY WRITE PID MAJ:MIN:INODE START END", device numbers in hex;
    # a process blocked on the lock has its own line with "->" after "N:".
    return any(key in line.split() for line in proc_locks.splitlines())


def _key(path: Path) -> str | None:
    try:
        st = path.stat()
    except FileNotFoundError:
        return None
    return f"{os.major(st.st_dev):02x}:{os.minor(st.st_dev):02x}:{st.st_ino}"


def lock_users(proc_locks: str) -> tuple[set[str], set[str]]:
    """PIDs that hold or wait for the GPU lock, and those among them that also hold
    ``untimed.lock``. An owner without a PID (an OFD lock reads -1) is never matched: it counts
    as timed, the safe side."""
    gpu, untimed_key = _key(LOCK), _key(UNTIMED)
    users: set[str] = set()
    untimed: set[str] = set()
    for line in proc_locks.splitlines():
        fields = line.split()
        if gpu is not None and gpu in fields:
            users.add(fields[fields.index(gpu) - 1])
        if untimed_key is not None and untimed_key in fields and "->" not in fields:
            pid = fields[fields.index(untimed_key) - 1]
            if pid.isdigit() and int(pid) > 0:
                untimed.add(pid)
    return users, users & untimed


def freeze_wanted(proc_locks: str) -> bool:
    """Whether a process holds or waits for the GPU lock without holding ``untimed.lock``: a
    timed measurement, or any holder that did not say it times nothing. Fail-safe: a holder
    unknown to this rule (an older wrapper, a raw flock, autan-bench) freezes campaigns. Only
    holders and blocked waiters are seen: a waiter that polls (autan-gpu-lock, autan-bench)
    appears once it holds, and autan-bench then waits for every campaign to read frozen."""
    users, untimed = lock_users(proc_locks)
    return bool(users - untimed)


def _state_of(stat_file: Path) -> bytes | None:
    try:
        # proc(5): the state follows the parenthesised command name.
        return stat_file.read_bytes().rpartition(b")")[2].split()[0]
    except (OSError, IndexError):
        return None


def other_runnable() -> int:
    """Threads in state R outside every campaign (each watcher publishes its campaign's cgroup
    in campaigns/NAME.cgroup), this watcher excluded: campaigns are not another project's load.
    Both counts come from the threads' own states, so CPU-quota throttling does not skew them."""
    total = sum(1 for t in Path("/proc").glob("[0-9]*/task/[0-9]*/stat") if _state_of(t) == b"R")
    return max(0, total - campaigns_running() - 1)


def campaigns_running() -> int:
    """Threads in state R in the cgroups that live campaigns' watchers published: a publication
    counts only under CGROUPS and with a fresh heartbeat, each thread once."""
    tids: set[str] = set()
    for published in STATES.glob("*.cgroup"):
        try:
            fresh = time.time() - published.with_suffix(".heartbeat").stat().st_mtime
            cgroup = Path(published.read_text().strip()).resolve()
            if fresh > HEARTBEAT_MAX_AGE_S or not cgroup.is_relative_to(CGROUPS):
                continue
            tids.update((cgroup / "cgroup.threads").read_text().split())
        except (OSError, ValueError):
            continue
    return sum(1 for tid in tids if _state_of(Path(f"/proc/{tid}/stat")) == b"R")


class ForeignLoad:
    """The rule that stops a campaign beside another project's load: the median of
    LOAD_SAMPLES samples, one every LOAD_EVERY_S, above MAX_OTHER_LOAD for LOAD_GRACE_S. Not
    counted while the campaign is frozen, nor while an untimed hold (a build, a test) runs:
    that load is admitted work."""

    def __init__(self) -> None:
        self.samples: list[int] = []
        self.busy_since: float | None = None
        self.next_sample = 0.0

    def update(self, paused: bool, now: float, sample: Callable[[], int]) -> int | None:
        """The foreign load that ends the campaign, or None."""
        if paused:
            self.samples.clear()
            self.busy_since = None
            return None
        if now >= self.next_sample:
            self.samples.append(sample())
            self.next_sample = now + LOAD_EVERY_S
        if len(self.samples) < LOAD_SAMPLES:
            return None
        load = sorted(self.samples)[len(self.samples) // 2]
        self.samples.clear()
        if load <= MAX_OTHER_LOAD:
            self.busy_since = None
        elif self.busy_since is None:
            self.busy_since = now
        elif now - self.busy_since >= LOAD_GRACE_S:
            return load
        return None


def docker(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["docker", *args], check=check, capture_output=True, text=True, timeout=DOCKER_TIMEOUT_S
    )


def cgroup_of(name: str) -> Path:
    """The container's cgroup v2 directory, read from its main process."""
    for _ in range(50):
        out = docker("inspect", "-f", "{{.State.Status}} {{.State.Pid}}", name).stdout.split()
        if out[0] != "running":
            logs = docker("logs", "--tail", "5", name, check=False)
            sys.exit(f"autan-campaign: container {name} is {out[0]} right after start:"
                     f" {logs.stdout[-500:]}{logs.stderr[-500:]}")  # fmt: skip
        try:
            relative = Path(f"/proc/{out[1]}/cgroup").read_text().strip().removeprefix("0::")
        except FileNotFoundError:
            relative = ""
        cgroup = Path("/sys/fs/cgroup") / relative.lstrip("/")
        if relative and (cgroup / "cgroup.threads").exists():
            return cgroup
        time.sleep(0.1)
    sys.exit(f"autan-campaign: no cgroup v2 directory for container {name}")


def publish(name: str, state: str) -> None:
    """Write campaigns/NAME.state atomically: autan-bench reads it before measuring."""
    STATES.mkdir(mode=0o755, exist_ok=True)
    tmp = STATES / f".{name}.state"
    tmp.write_text(state + "\n")
    tmp.chmod(0o644)
    tmp.replace(STATES / f"{name}.state")


def _say(text: str) -> None:
    sys.stdout.write(text + "\n")


def log(name: str, message: str) -> None:
    STATE.mkdir(exist_ok=True)
    stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    with (STATE / f"{name}.log").open("a") as handle:
        handle.write(f"{stamp} {message}\n")


def _start_time(pid: int) -> str | None:
    try:
        # proc(5): field 22, starttime; 20th after the parenthesised command name.
        return Path(f"/proc/{pid}/stat").read_text().rpartition(")")[2].split()[19]
    except (OSError, IndexError):
        return None


def remove(name: str) -> bool:
    """Remove the container; True once docker no longer lists it."""
    container = PREFIX + name
    for _ in range(3):
        with contextlib.suppress(subprocess.TimeoutExpired):
            docker("rm", "-f", container, check=False)
            if not docker("ps", "-aq", "--filter", f"name=^{container}$").stdout.strip():
                return True
        time.sleep(1)
    return False


def watch(name: str, floor: int) -> int:
    container = PREFIX + name
    heartbeat = STATES / f"{name}.heartbeat"
    stopping = False

    def stop(*_: object) -> None:
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    pid = os.getpid()
    (STATE / f"{name}.pid").write_text(f"{pid} {_start_time(pid)}\n")
    ended = False
    try:
        while not stopping and freeze_wanted(Path("/proc/locks").read_text()):
            heartbeat.touch()
            time.sleep(POLL_S)
        if stopping:
            log(name, "stopped before it started")
            return 0
        if memfloor.below(floor):
            log(name, f"{memfloor.show(memfloor.available())} of host memory available, below "
                      f"--free {memfloor.show(floor)}: not started")  # fmt: skip
            return 1
        # Its own thread: the loop below waits on docker calls (up to 30 s each), the floor
        # cannot. It kills the container at once, and again every second while the floor is
        # not met, in case the container was not running yet; the loop then removes it.
        breached = threading.Event()

        def guard() -> None:
            while not stopping:
                if memfloor.below(floor):
                    breached.set()
                    with contextlib.suppress(subprocess.SubprocessError, OSError):
                        docker("kill", container, check=False)
                    time.sleep(1.0)
                else:
                    time.sleep(POLL_S)

        threading.Thread(target=guard, daemon=True).start()
        # "running" is published before the start, so that a measurement that takes the lock
        # in between waits for the freeze instead of measuring beside the campaign.
        publish(name, "running")
        heartbeat.touch()
        # A measurement that took the lock between the wait above and this publish may have read
        # the state before it: checked again now, it waits for this campaign, never runs beside it.
        while not stopping and freeze_wanted(Path("/proc/locks").read_text()):
            publish(name, "frozen")
            while not stopping and freeze_wanted(Path("/proc/locks").read_text()):
                heartbeat.touch()
                time.sleep(POLL_S)
            publish(name, "running")
        if stopping:
            log(name, "stopped before it started")
            return 0
        if breached.is_set():
            log(name, f"host memory available fell below --free {memfloor.show(floor)}: "
                      "not started")  # fmt: skip
            return 1
        docker("start", container)
        cgroup = cgroup_of(container)
        (STATES / f"{name}.cgroup").write_text(f"{cgroup}\n")
        log(name, "started")
        frozen = False
        # No docker call in the steady state: the CLI would load the CPU at every poll,
        # measurements included. The cgroup directory disappears with the container.
        foreign = ForeignLoad()
        while not stopping:
            heartbeat.touch()
            if breached.is_set():
                # Frozen or not: its memory is what the host needs back.
                log(name, f"host memory available fell below --free {memfloor.show(floor)}")
                return 1
            if not cgroup.exists():
                ended = True
                log(name, "campaign ended; `docker logs` keeps its output")
                return 0
            users, untimed = lock_users(Path("/proc/locks").read_text())
            wanted = bool(users - untimed)
            # An untimed hold's own load (a build, a test) is admitted work, not a foreign load.
            admitted = bool(untimed)
            if wanted and not frozen:
                docker("pause", container)
                publish(name, "frozen")
                frozen = True
                log(name, "GPU lock in use: frozen")
            elif not wanted and frozen:
                publish(name, "running")
                # As at the start: a measurement that read "frozen" just before the publish holds
                # the lock by now, and the campaign stays frozen for it.
                if freeze_wanted(Path("/proc/locks").read_text()):
                    publish(name, "frozen")
                else:
                    docker("unpause", container)
                    frozen = False
                    log(name, "GPU lock free: thawed")
            over = foreign.update(frozen or admitted, time.monotonic(), other_runnable)
            if over is not None:
                log(name, f"{over} runnable threads outside the campaign for a minute")
                return 1
            time.sleep(POLL_S)
        log(name, "stopped")
        return 0
    finally:
        # A campaign never outlives its watcher: unwatched, it would run through measurements.
        if not ended and not remove(name):
            log(name, f"FAILED to remove {container}; it stops by itself within "
                      f"{HEARTBEAT_MAX_AGE_S} s, when the heartbeat is stale")  # fmt: skip
            sys.exit(1)
        if not ended:
            log(name, "container removed")
        (STATES / f"{name}.state").unlink(missing_ok=True)
        (STATES / f"{name}.heartbeat").unlink(missing_ok=True)
        (STATES / f"{name}.cgroup").unlink(missing_ok=True)
        (STATE / f"{name}.pid").unlink(missing_ok=True)


def start(args: argparse.Namespace) -> int:
    if not LOCK.exists():
        sys.exit(f"autan-campaign: {LOCK} is missing; run docker/runner/deploy.sh start")
    container = PREFIX + args.name
    STATE.mkdir(exist_ok=True)
    if docker("ps", "-aq", "--filter", f"name=^{container}$").stdout.strip():
        sys.exit(f"autan-campaign: {container} already exists")
    floor = memfloor.parse(args.free)
    if floor is None:
        sys.exit(f"autan-campaign: --free {args.free!r} is not a size such as 24G or 512M")
    command = args.command
    if not command:
        sys.exit("autan-campaign: no command after --")
    workdir = Path(args.dir).resolve()
    STATES.mkdir(mode=0o755, exist_ok=True)
    heartbeat = STATES / f"{args.name}.heartbeat"
    heartbeat.touch()
    docker(
        "create", "--name", container, "--cpus", str(args.cpus), "--cpu-shares", "2",
        "--memory", "48g",
        "--user", f"{os.getuid()}:{os.getgid()}", "-e", "HOME=/tmp",
        "-v", f"{workdir}:/work", "-w", "/work",
        "-v", f"{heartbeat}:/autan-campaign/heartbeat:ro",
        args.image, "nice", "-n", "19", "sh", "-c", SUPERVISOR, "supervisor",
        "/autan-campaign/heartbeat", str(HEARTBEAT_MAX_AGE_S), *command,
    )  # fmt: skip
    # The watcher starts the container once the GPU lock is free, then freezes and thaws it.
    with (STATE / f"{args.name}.log").open("a") as errors:
        subprocess.Popen(
            [sys.executable, __file__, "_watch", args.name, str(floor)],
            start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=errors,
        )  # fmt: skip
    _say(f"created {container}; log: {STATE / (args.name + '.log')}")
    return 0


def status(_: argparse.Namespace) -> int:
    fmt = "{{.Names}}\t{{.Status}}"
    names = docker("ps", "-a", "--filter", f"name=^{PREFIX}", "--format", fmt).stdout.strip()
    _say(names or "no campaign")
    return 0


def stop_campaign(args: argparse.Namespace) -> int:
    pid_file = STATE / f"{args.name}.pid"
    if pid_file.exists():
        pid_text, _, started = pid_file.read_text().partition(" ")
        pid = int(pid_text)
        # Only the watcher that wrote the file: a PID reused after a reboot is someone else.
        cmdline = Path(f"/proc/{pid}/cmdline")
        ours = (
            _start_time(pid) == started.strip()
            and cmdline.exists()
            and f"_watch\0{args.name}\0" in cmdline.read_text()
        )
        if ours:
            with contextlib.suppress(ProcessLookupError):
                os.kill(pid, signal.SIGTERM)
                for _ in range(600):
                    os.kill(pid, 0)
                    time.sleep(0.1)
    if not remove(args.name):
        sys.exit(f"autan-campaign: could not remove {PREFIX + args.name}")
    (STATES / f"{args.name}.state").unlink(missing_ok=True)
    (STATES / f"{args.name}.heartbeat").unlink(missing_ok=True)
    (STATES / f"{args.name}.cgroup").unlink(missing_ok=True)
    _say(f"removed {PREFIX + args.name}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="autan-campaign", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(required=True)
    s = sub.add_parser("start", help="start a campaign")
    s.add_argument("name")
    s.add_argument("--cpus", type=float, default=12.0)
    s.add_argument("--free", default=memfloor.DEFAULT,
                   help="host memory to keep available, as 24G or 512M (0G for none)")  # fmt: skip
    s.add_argument("--image", default="autan-dev:local")
    s.add_argument("--dir", default=".", help="directory mounted at /work")
    s.set_defaults(func=start)
    sub.add_parser("status", help="list campaigns").set_defaults(func=status)
    k = sub.add_parser("stop", help="stop a campaign")
    k.add_argument("name")
    k.set_defaults(func=stop_campaign)
    w = sub.add_parser("_watch", help=argparse.SUPPRESS)
    w.add_argument("name")
    w.add_argument("floor", type=int)
    w.set_defaults(func=lambda a: watch(a.name, a.floor))
    argv = sys.argv[1:] if argv is None else argv
    # argparse.REMAINDER would also swallow the options before "--".
    split = argv.index("--") if "--" in argv else len(argv)
    args = parser.parse_args(argv[:split])
    args.command = argv[split + 1 :]
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
