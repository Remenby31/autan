# clang-format 23.1.3, pinned in .pre-commit-config.yaml. Use exactly this version.
# No Language key: the style applies to C++, CUDA and Objective-C++ (.mm, Metal host code) alike.
BasedOnStyle: Google
DerivePointerAlignment: false
Standard: c++20
ColumnLimit: 100
PointerAlignment: Left
ReferenceAlignment: Left
QualifierAlignment: Left
InsertNewlineAtEOF: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<[a-z_]+>$'
    Priority: 1
  - Regex: '^<'
    Priority: 2
  - Regex: '.*'
    Priority: 4
AttributeMacros:
  - __host__
  - __device__
  - __global__
  - __forceinline__
  - __launch_bounds__
  - __restrict__
