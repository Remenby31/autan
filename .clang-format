# clang-format 23.1.3, pinned in .pre-commit-config.yaml. Use exactly this version.
# Objective-C++ (.mm, Metal host code) takes the same settings as C++.
---
Language: Cpp
BasedOnStyle: Google
DerivePointerAlignment: false
Standard: c++20
ColumnLimit: 100
PointerAlignment: Left
ReferenceAlignment: Left
QualifierAlignment: Left
InsertNewlineAtEOF: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<[a-z_]+>$'
    Priority: 1
  - Regex: '^<'
    Priority: 2
  - Regex: '.*'
    Priority: 4
AttributeMacros:
  - __host__
  - __device__
  - __global__
  - __forceinline__
  - __launch_bounds__
  - __restrict__
---
Language: ObjC
BasedOnStyle: Google
DerivePointerAlignment: false
Standard: c++20
ColumnLimit: 100
PointerAlignment: Left
ReferenceAlignment: Left
QualifierAlignment: Left
InsertNewlineAtEOF: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<[a-z_]+>$'
    Priority: 1
  - Regex: '^<'
    Priority: 2
  - Regex: '.*'
    Priority: 4
AttributeMacros:
  - __host__
  - __device__
  - __global__
  - __forceinline__
  - __launch_bounds__
  - __restrict__
