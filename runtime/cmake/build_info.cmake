# Writes OUT with the solver version and the full git commit of SOURCE,
# rewriting it only when they change. A build outside a git checkout must
# pass AUTAN_COMMIT (40 hexadecimal characters).
if(DEFINED AUTAN_COMMIT AND NOT AUTAN_COMMIT STREQUAL "")
  set(commit "${AUTAN_COMMIT}")
else()
  execute_process(
    COMMAND git -C "${SOURCE}" rev-parse HEAD
    OUTPUT_VARIABLE commit
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE status
  )
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "no git commit for ${SOURCE}; pass -DAUTAN_COMMIT=<40 hex characters>")
  endif()
endif()
if(NOT commit MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "AUTAN_COMMIT must be 40 lowercase hexadecimal characters, got '${commit}'")
endif()
string(LENGTH "${commit}" length)
if(NOT length EQUAL 40)
  message(FATAL_ERROR "AUTAN_COMMIT must be 40 lowercase hexadecimal characters, got '${commit}'")
endif()
set(
  text
  "#pragma once\n// Generated by runtime/cmake/build_info.cmake.\n#define AUTAN_BUILD_VERSION \"${VERSION}\"\n#define AUTAN_BUILD_COMMIT \"${commit}\"\n"
)
if(EXISTS "${OUT}")
  file(READ "${OUT}" previous)
endif()
if(NOT previous STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
