# Writes OUT with the solver version, the full git commit of SOURCE and whether the build's tracked
# files differ from that commit, rewriting it only when they change. SOURCE is a checkout when it
# holds .git, and dirty means `git status --porcelain --untracked-files=no` lists a change: the
# SDK's rule (py/build_hook.py). A build elsewhere (an export) passes AUTAN_COMMIT (40 hexadecimal
# characters) and AUTAN_DIRTY (ON or OFF).
if(EXISTS "${SOURCE}/.git")
  execute_process(
    COMMAND git -C "${SOURCE}" rev-parse HEAD
    OUTPUT_VARIABLE commit
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE status
  )
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "git rev-parse HEAD failed in ${SOURCE}")
  endif()
  execute_process(
    COMMAND git -C "${SOURCE}" status --porcelain --untracked-files=no
    OUTPUT_VARIABLE changes
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE status
  )
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "git status failed in ${SOURCE}")
  endif()
  if(changes STREQUAL "")
    set(dirty false)
  else()
    set(dirty true)
  endif()
elseif(DEFINED AUTAN_COMMIT AND NOT AUTAN_COMMIT STREQUAL "")
  set(commit "${AUTAN_COMMIT}")
  if(NOT AUTAN_DIRTY MATCHES "^(ON|OFF)$")
    message(
      FATAL_ERROR
      "a build outside a git checkout passes -DAUTAN_DIRTY=ON or OFF with AUTAN_COMMIT, "
      "got '${AUTAN_DIRTY}'"
    )
  endif()
  if(AUTAN_DIRTY)
    set(dirty true)
  else()
    set(dirty false)
  endif()
else()
  message(
    FATAL_ERROR
    "no git checkout at ${SOURCE}; pass -DAUTAN_COMMIT=<40 hex characters> -DAUTAN_DIRTY=ON|OFF"
  )
endif()
if(NOT commit MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "AUTAN_COMMIT must be 40 lowercase hexadecimal characters, got '${commit}'")
endif()
string(LENGTH "${commit}" length)
if(NOT length EQUAL 40)
  message(FATAL_ERROR "AUTAN_COMMIT must be 40 lowercase hexadecimal characters, got '${commit}'")
endif()
set(
  text
  "#pragma once\n// Generated by runtime/cmake/build_info.cmake.\n#define AUTAN_BUILD_VERSION \"${VERSION}\"\n#define AUTAN_BUILD_COMMIT \"${commit}\"\n#define AUTAN_BUILD_DIRTY ${dirty}\n"
)
if(EXISTS "${OUT}")
  file(READ "${OUT}" previous)
endif()
if(NOT previous STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
