# Run by CI on the compilation database (CMAKE_EXPORT_COMPILE_COMMANDS). Every exclusion says why.
#  -bugprone-easily-swappable-parameters: kernels take many same-typed arrays by design.
#  -bugprone-narrowing-conversions: duplicate of cppcoreguidelines-narrowing-conversions, which we do not enable; -Wconversion covers it.
#  -misc-include-cleaner: needs an IWYU mapping for CUDA and HIP headers that we do not have yet.
#  -misc-non-private-member-variables-in-classes: SoA mesh structs expose their arrays on purpose.
#  -modernize-use-trailing-return-type, -modernize-use-designated-initializers: style only.
#  -portability-avoid-pragma-once: GCC, Clang, nvcc and hipcc all support #pragma once.
#  -modernize-avoid-c-arrays: device code uses fixed-size C arrays for registers.
#  -readability-identifier-length: i, j, k, n, x, y, z, u, v, w are the names the equations use.
#  -readability-magic-numbers: numerical constants come from the paper they cite.
#  -performance-enum-size: underlying types are chosen for a stable range (error codes, file formats), not for size.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-designated-initializers,
  -modernize-avoid-c-arrays,
  performance-*,
  -performance-enum-size,
  portability-*,
  -portability-avoid-pragma-once,
  readability-container-size-empty,
  readability-duplicate-include,
  readability-else-after-return,
  readability-implicit-bool-conversion,
  readability-inconsistent-declaration-parameter-name,
  readability-make-member-function-const,
  readability-misleading-indentation,
  readability-redundant-*,
  readability-simplify-boolean-expr,
  readability-static-accessed-through-instance,
  readability-use-anyofallof
WarningsAsErrors: "*"
HeaderFilterRegex: "^.*/(core|io|kernels|codegen|solvers|physics|py)/.*"
FormatStyle: file
